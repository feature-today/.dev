{
  "name": "Feature Today",
  // Stable machine name: Remote Control names the environment "<hostname>:<folder>", and the
  // default hostname is the container id, which changes on every rebuild.
  "runArgs": ["--hostname=feature-today"],
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  // Orchestrator devcontainer for the feature-today organization.
  //
  // The sibling feature-today repos are cloned by the org-workspace feature
  // into /workspaces/<name>, next to this project, and the multi-root workspace
  // (feature-today.code-workspace) is kept up to date by the same feature.
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "features": {
    // Secrets come from OpenBao (kv/shared/*, then kv/orgs/feature-today) into every process's env,
    // VS Code included. Not in remoteEnv: `${localEnv:…}` is empty when VS Code attaches and
    // would override them.
    "ghcr.io/helpers4/devcontainer/openbao-env:1": {
      "address": "https://bao.baxyz.dev:8200",
      "paths": "shared/font-awesome,shared/web-awesome,orgs/feature-today"
    },
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork"
    },
    // moby:false → use upstream docker-ce CLI; required since the base image
    // moved to Debian trixie where moby-cli is no longer packaged.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    // ── helpers4 features ─────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/shell-history:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {
      "remoteControl": true,
      "remoteControlAutoTrust": true
    },
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "feature-today",
      "license": "AGPL-3.0-or-later"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "oxc.oxc-vscode",
        "qwik.qwik-vscode",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
        "eamodio.gitlens"
      ]
    }
  },
  // Forwarded ports cover every sibling project's dev server.
  // Qwik/Vite default: 5173 (my), 5174 (website), 4173 (preview)
  "forwardPorts": [
    5173,
    5174,
    4173,
    3000
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev — my",
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "Vite dev — website",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Vite preview",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Misc dev",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node"
}
