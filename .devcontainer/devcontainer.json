{
  "name": "feature-today",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "workspaceFolder": "/workspaces/feature-today-dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/feature-today-dev,type=bind,consistency=cached",
  "mounts": [
    // ── sibling repos ────────────────────────────────────────────────────────
    "source=${localWorkspaceFolder}/../.github,target=/workspaces/.github,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../website,target=/workspaces/website,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../my,target=/workspaces/my,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../common,target=/workspaces/common,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../server,target=/workspaces/server,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "FT_ORG": "feature-today",
    "FT_REPOS": ".github website my common server",
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_FEATURE_TODAY}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_FEATURE_TODAY}"
  },
  "features": {
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    // ── helpers4 features ─────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/dotfiles-sync:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "packs": "peasant_fr,peon_fr,warcraft-peon"
    },
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "feature-today",
      "license": "AGPL-3.0-or-later"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "oxc.oxc-vscode",
        "qwik.qwik-vscode",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
        "eamodio.gitlens"
      ]
    }
  },
  // Forwarded ports cover every sibling project's dev server.
  // Qwik/Vite default: 5173 (my), 5174 (website), 4173 (preview)
  "forwardPorts": [
    5173,
    5174,
    4173,
    3000
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev — my",
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "Vite dev — website",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Vite preview",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Misc dev",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}