{
  "name": "Feature Today",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  // Orchestrator devcontainer for the feature-today organization.
  //
  // Bind-mounts every sibling feature-today repo from the host (../<name>) into
  // /workspaces/<name>. The multi-root workspace (feature-today.code-workspace)
  // references each sibling via "../<name>", which resolves to the bind
  // mount inside the container and to the real sibling folder on host.
  //
  // Falls back to `git clone` inside the container if a sibling repo is
  // missing on host (e.g. GitHub Codespaces) — see setup-container.sh.
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "mounts": [
    // Shared pnpm store volume — persists across rebuilds and between sibling devcontainers.
    // store-dir is configured in setup-container.sh via ~/.npmrc (pnpm 10/11 compatible).
    "source=global-devcontainer-pnpm-store,target=/.pnpm-store,type=volume"
  ],
  "containerEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_FEATURE_TODAY}"
  },
  // GH_TOKEN: forwards the host gh CLI token into the container so gh and the
  // GitHub VS Code extensions are authenticated out of the box.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_FEATURE_TODAY}"
  },
  "features": {
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork"
    },
    // moby:false → use upstream docker-ce CLI; required since the base image
    // moved to Debian trixie where moby-cli is no longer packaged.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    // ── helpers4 features ─────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/dotfiles-sync:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {
      "remoteControl": true,
      "remoteControlAutoTrust": true
    },
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "feature-today",
      "license": "AGPL-3.0-or-later"
    },
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "packs": "peasant_fr,peon_fr,warcraft-peon"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "oxc.oxc-vscode",
        "qwik.qwik-vscode",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
        "eamodio.gitlens"
      ]
    }
  },
  // Forwarded ports cover every sibling project's dev server.
  // Qwik/Vite default: 5173 (my), 5174 (website), 4173 (preview)
  "forwardPorts": [
    5173,
    5174,
    4173,
    3000
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev — my",
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "Vite dev — website",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Vite preview",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "Misc dev",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}
